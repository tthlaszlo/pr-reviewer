APP_PORT=3000
APP_URL=http://localhost:3000
# Register a GitHub App with callback http://localhost:3000/auth/github/callback.
# Read-only permissions: Pull requests, Issues (timeline), Organization Members.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional link to your app's installation page (https://github.com/apps/YOUR-APP/installations/new).
GITHUB_INSTALL_URL=
# Google OAuth web application callback: http://localhost:3000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Required with either provider configured. Generate: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=
# Production: use a managed database's private connection URL.
DATABASE_URL=postgres://reviewer:reviewer@db:5432/reviewer

# Optional: reuse an existing named database volume when upgrading.
DATABASE_VOLUME=ai-buddy_database
